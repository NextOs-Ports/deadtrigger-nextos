{
  "schema_version": 1,
  "classes": {
    "pure": "Read-only/static validation; no temporary tree, hardware or signals",
    "filesystem": "May create an owned mktemp tree and child tools; never signals or touches hardware",
    "process": "Exercises supervision or signals and is permitted only inside the sealed user/PID/mount namespace",
    "hardware": "May observe a real device/backend and is never part of an automatic host gate"
  },
  "policy": {
    "logged_runner": "framework/tools/run-logged.sh",
    "process_runner": "framework/nxbootstrap/tests/run-isolated.sh",
    "hardware_automatic": false,
    "host_signal_authority": "none",
    "device_access_authority": "current-session explicit user authorization only"
  },
